# Copier en .env à côté de docker-compose.yml sur jobtrack-server, jamais commité.

# Connexion à mysql-db (service de ../infra/docker-compose.yml), ex. :
# mysql://jobtrack:motdepasse@mysql-db:3306/jobtrack
DATABASE_URL=

# JWT access/refresh JobTrack (secrets distincts, à générer)
ACCESS_SECRET_KEY=
ACCESS_JWT_EXPIRE=15m
REFRESH_SECRET_KEY=
REFRESH_JWT_EXPIRE=7d

# JWT dédié à MS-Messagerie — DOIT être strictement identique à
# MESSAGING_JWT_SECRET dans Microservices/messagerie/.env sur ce même serveur
MESSAGING_JWT_SECRET=
MESSAGING_JWT_EXPIRE=1h

# true en prod (conditionne l'attribut `secure` du cookie de refresh)
PROD=true

# Port d'écoute interne du conteneur (doit rester cohérent avec l'EXPOSE du
# Dockerfile et le mapping du docker-compose)
PORT=3000

# Origine du Frontend en prod — utilisée pour le lien de reset password ET
# whitelistée en CORS (voir src/main.ts). Ex. https://www.jobtrack.tech
FRONTEND_URL=

# Port hôte exposé par docker-compose (mapping vers le 3000 du conteneur)
BACKEND_PORT=3000
