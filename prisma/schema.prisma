generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Application {
  id                   Int                    @id @unique(map: "id_UNIQUE") @default(autoincrement())
  user_id              Int
  job_offering_id      Int
  status               Application_status     @default(PENDING)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  job_offering         Job_offering           @relation(fields: [job_offering_id], references: [id], onDelete: Cascade, map: "fk_application_job")
  user                 User                   @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_application_user")
  application_document Application_document[]
  interview            Interview[]
  message              Message[]

  @@index([job_offering_id], map: "fk_application_job")
  @@index([user_id], map: "fk_application_user")
}

model Application_document {
  application_id Int
  document_id    Int
  created_at     DateTime    @default(now()) @db.Timestamp(0)
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade, map: "fk_ad_application")
  document       Document    @relation(fields: [document_id], references: [id], onDelete: Cascade, map: "fk_ad_document")

  @@id([application_id, document_id])
  @@index([document_id], map: "fk_ad_document")
}

model Comment {
  id                Int         @id @unique(map: "id_UNIQUE") @default(autoincrement())
  publication_id    Int
  user_id           Int
  parent_comment_id Int?
  content           String      @db.Text
  created_at        DateTime    @default(now()) @db.Timestamp(0)
  updated_at        DateTime    @default(now()) @db.Timestamp(0)
  comment           Comment?    @relation("commentTocomment", fields: [parent_comment_id], references: [id], map: "fk_comment_parent")
  other_comment     Comment[]   @relation("commentTocomment")
  publication       Publication @relation(fields: [publication_id], references: [id], onDelete: Cascade, map: "fk_comment_publication")
  user              User        @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_comment_user")

  @@index([parent_comment_id], map: "fk_comment_parent")
  @@index([publication_id], map: "fk_comment_publication")
  @@index([user_id], map: "fk_comment_user")
}

model Company {
  id               Int                @id @unique(map: "id_UNIQUE") @default(autoincrement())
  name             String             @unique(map: "company_name_UNIQUE") @db.VarChar(255)
  business_sector  String             @db.VarChar(150)
  size             String?            @db.VarChar(20)
  website          String?            @db.VarChar(255)
  address          String?            @db.Text
  description      String?            @db.Text
  logo_url         String?            @db.LongText
  banner_url       String?            @db.LongText
  is_public        Boolean            @default(true)
  verified         Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  updated_at       DateTime           @default(now()) @db.Timestamp(0)
  company_follower Company_follower[]
  contact          Contact[]
  employment       Employment[]
  job_offering     Job_offering[]

  @@index([business_sector], map: "business_sector")
}

model Company_follower {
  user_id    Int
  company_id Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade, map: "fk_cf_company")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_cf_user")

  @@id([user_id, company_id])
  @@index([company_id], map: "fk_cf_company")
}

model Connection {
  user_action_id                         Int
  user_receiver_id                       Int
  status                                 Connection_status  @default(PENDING)
  created_at                             DateTime          @default(now()) @db.Timestamp(0)
  updated_at                             DateTime          @default(now()) @db.Timestamp(0)
  user_connection_user_action_idTouser   User              @relation("connection_user_action_idTouser", fields: [user_action_id], references: [id], onDelete: Cascade, map: "fk_conn_action")
  user_connection_user_receiver_idTouser User              @relation("connection_user_receiver_idTouser", fields: [user_receiver_id], references: [id], onDelete: Cascade, map: "fk_conn_receiver")

  @@id([user_action_id, user_receiver_id])
  @@index([user_receiver_id], map: "fk_connection_receiver")
}

model Contact {
  id            Int      @id @unique(map: "id_UNIQUE") @default(autoincrement())
  company_id    Int
  contact_name  String   @db.VarChar(255)
  job_title     String   @db.VarChar(150)
  contact_email String   @unique(map: "contact_email_UNIQUE") @db.VarChar(255)
  phone_number  String?  @db.VarChar(50)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
  company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade, map: "fk_contact_company")

  @@index([company_id], map: "fk_contact_company")
}

model Document {
  id                   Int                    @id @unique(map: "id_UNIQUE") @default(autoincrement())
  user_id              Int?
  title                String                 @db.VarChar(255)
  type                 Document_type
  file_url             String                 @unique(map: "file_url_UNIQUE") @db.VarChar(500)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  application_document Application_document[]
  user                 User?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_document_user")

  @@index([user_id], map: "fk_document_user")
}

model Employment {
  user_id    Int
  company_id Int
  job_title  String    @db.VarChar(255)
  start_date DateTime  @db.Date
  end_date   DateTime? @db.Date
  is_current Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime  @default(now()) @db.Timestamp(0)
  company    Company   @relation(fields: [company_id], references: [id], onDelete: Cascade, map: "fk_emp_company")
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_emp_user")

  @@id([user_id, company_id])
  @@index([company_id], map: "fk_emp_company")
}

model Interview {
  id             Int                      @id @unique(map: "id_UNIQUE") @default(autoincrement())
  application_id Int
  interview_type Interview_interview_type
  scheduled_at   DateTime                 @db.Timestamp(0)
  notes          String?                  @db.Text
  created_at     DateTime                 @default(now()) @db.Timestamp(0)
  updated_at     DateTime                 @default(now()) @db.Timestamp(0)
  application    Application              @relation(fields: [application_id], references: [id], onDelete: Cascade, map: "fk_interview_application")

  @@index([application_id], map: "fk_interview_application")
  @@index([scheduled_at], map: "fk_interview_schedule")
}

/// Référentiel des catégories d'offres (secteur d'activité + modes de travail).
/// Alimente le filtre « Catégorie » du Front et la résolution du libellé sur
/// la fiche offre. `key` = clé stable renvoyée par `JobOfferingService`
/// (`inferCategory` / `inferWorkMode`). Le pictogramme et la pastille de
/// couleur restent côté Front (map `key` -> style dans `data/offerCategories`).
model Job_category {
  id           Int      @id @unique(map: "id_UNIQUE") @default(autoincrement())
  key          String   @unique(map: "job_category_key_UNIQUE") @db.VarChar(50)
  label        String   @db.VarChar(100)
  description  String   @db.Text
  is_work_mode Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @db.Timestamp(0)
}

model Job_offering {
  id            Int                        @id @unique(map: "id_UNIQUE") @default(autoincrement())
  company_id    Int
  title         String                     @db.VarChar(255)
  contract_type Job_offering_contract_type
  description   String                     @db.Text
  created_at    DateTime                   @default(now()) @db.Timestamp(0)
  updated_at    DateTime                   @default(now()) @db.Timestamp(0)
  deleted_at    DateTime?                  @db.Timestamp(0)
  application   Application[]
  company       Company                    @relation(fields: [company_id], references: [id], onDelete: Cascade, map: "fk_job_company")
  message       Message[]

  @@index([company_id], map: "fk_job_company")
}

model Message {
  id                              Int           @id @unique(map: "id_UNIQUE") @default(autoincrement())
  recipient_id                    Int
  sender_id                       Int
  application_context_id          Int?
  job_context_id                  Int?
  content                         String        @db.Text
  created_at                      DateTime      @default(now()) @db.Timestamp(0)
  application                     Application?  @relation(fields: [application_context_id], references: [id], map: "fk_message_application")
  job_offering                    Job_offering? @relation(fields: [job_context_id], references: [id], map: "fk_message_job")
  user_message_recipient_idTouser User          @relation("message_recipient_idTouser", fields: [recipient_id], references: [id], onDelete: Cascade, map: "fk_message_recipient")
  user_message_sender_idTouser    User          @relation("message_sender_idTouser", fields: [sender_id], references: [id], onDelete: Cascade, map: "fk_message_sender")

  @@index([application_context_id], map: "fk_message_application")
  @@index([job_context_id], map: "fk_message_job")
  @@index([recipient_id], map: "fk_message_recipient")
  @@index([sender_id], map: "fk_message_sender")
}

model Notification {
  id             Int                     @id @unique(map: "id_UNIQUE") @default(autoincrement())
  target_user_id Int
  trigger_id     Int
  source_id      Int?
  event_type     Notification_event_type
  is_read        Boolean                 @default(false)
  created_at     DateTime                @default(now()) @db.Timestamp(0)
  updated_at     DateTime                @default(now()) @db.Timestamp(0)
  user           User                    @relation(fields: [target_user_id], references: [id], onDelete: Cascade, map: "fk_notification_target")

  @@index([target_user_id], map: "fk_notification_target")
}

model Publication {
  id          Int              @id @unique(map: "id_UNIQUE") @default(autoincrement())
  user_id     Int
  title       String           @db.VarChar(255)
  content     String           @db.Text
  image_url   String?          @db.LongText
  type        Publication_type
  is_public   Boolean          @default(true)
  likes_count Int              @default(0)
  created_at  DateTime         @default(now()) @db.Timestamp(0)
  updated_at  DateTime         @default(now()) @db.Timestamp(0)
  deleted_at  DateTime?        @db.Timestamp(0)
  comment     Comment[]
  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_publication_user")

  @@index([user_id], map: "fk_publication_user")
}

model Role {
  id          Int      @id @unique(map: "id_UNIQUE") @default(autoincrement())
  name        String   @unique(map: "name_UNIQUE") @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
  user        User[]
}

model Skill {
  id         Int          @id @unique(map: "id_UNIQUE") @default(autoincrement())
  name       String       @unique(map: "name_UNIQUE") @db.VarChar(150)
  created_at DateTime     @default(now()) @db.Timestamp(0)
  updated_at DateTime     @default(now()) @db.Timestamp(0)
  user_skill User_skill[]
}

model User {
  id                                           Int                @id @default(autoincrement())
  role_id                                      Int?
  first_name                                   String             @db.VarChar(100)
  last_name                                    String             @db.VarChar(100)
  email                                        String             @unique(map: "email") @db.VarChar(255)
  password                                     String             @db.VarChar(255)
  avatar_url                                   String?            @db.Text
  headline                                     String?            @db.VarChar(150)
  bio                                          String?            @db.Text
  location                                     String?            @db.VarChar(150)
  phone                                        String?            @db.VarChar(40)
  website                                      String?            @db.VarChar(255)
  linkedin                                     String?            @db.VarChar(255)
  github                                       String?            @db.VarChar(255)
  banner_url                                   String?            @db.LongText
  notifications_enabled                        Boolean            @default(true)
  language                                     String             @default("fr")
  refreshToken                                 String?            @db.LongText
  resetPasswordToken                           String?            @db.VarChar(255)
  resetPasswordExpires                         DateTime?          @db.Timestamp(0)
  created_at                                   DateTime           @default(now()) @db.Timestamp(0)
  updated_at                                   DateTime           @default(now()) @db.Timestamp(0)
  deleted_at                                   DateTime?          @db.Timestamp(0)
  application                                  Application[]
  comment                                      Comment[]
  company_follower                             Company_follower[]
  document                                     Document[]
  connection_connection_user_action_idTouser   Connection[]       @relation("connection_user_action_idTouser")
  connection_connection_user_receiver_idTouser Connection[]       @relation("connection_user_receiver_idTouser")
  employment                                   Employment[]
  message_message_recipient_idTouser           Message[]          @relation("message_recipient_idTouser")
  message_message_sender_idTouser              Message[]          @relation("message_sender_idTouser")
  notification                                 Notification[]
  publication                                  Publication[]
  role                                         Role?              @relation(fields: [role_id], references: [id], map: "fk_user_role")
  user_skill                                   User_skill[]

  @@index([role_id], map: "fk_user_role")
}

model User_skill {
  user_id    Int
  skill_id   Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  skill      Skill    @relation(fields: [skill_id], references: [id], onDelete: Cascade, map: "fk_uc_competence")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_uc_user")

  @@id([user_id, skill_id])
  @@index([skill_id], map: "fk_uc_competence")
}

enum Connection_status {
  PENDING
  ACCEPTED
  REJECTED
}

enum Document_type {
  CV
  LETTRE
  DIPLOME
}

enum Interview_interview_type {
  TELEPHONE
  VISIO
  PRESENTIEL
}

enum Application_status {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Job_offering_contract_type {
  CDI
  CDD
  Freelance
  Stage
}

enum Notification_event_type {
  NEW_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  NEW_MESSAGE
  INTERVIEW_INVITATION
  INTERVIEW_REMINDER
}

enum Publication_type {
  ARTICLE
  ANNONCE
  ACTU
}
