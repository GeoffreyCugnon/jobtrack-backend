meta {
  name: "Login"
  type: "http"
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (body && body.accessToken) {
    bru.setVar("accessToken", body.accessToken);
  }
}

body {
  "email": "{{loginEmail}}",
  "password": "{{loginPassword}}"
}
